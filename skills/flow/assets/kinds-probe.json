{
  "title": "Node, edge and topology probe",
  "flows": [
    {
      "title": "Fork and join",
      "summary": "Invented steps with no refs. Together with the state-machine tab, this covers every node and edge kind.",
      "nodes": [
        { "id": "s", "label": "Start", "kind": "start" },
        { "id": "f", "label": "Fan out", "kind": "fork", "note": "all three run" },
        { "id": "a", "label": "Read config", "kind": "io" },
        { "id": "b", "label": "Load cache", "kind": "store", "note": "warm" },
        { "id": "c", "label": "Compile assets", "kind": "step" },
        { "id": "j", "label": "Converge", "kind": "join" },
        { "id": "d", "label": "All succeeded?", "kind": "decision" },
        { "id": "ok", "label": "Done", "kind": "success" },
        { "id": "err", "label": "Failed", "kind": "end" }
      ],
      "edges": [
        { "from": "s", "to": "f" },
        { "from": "f", "to": "a" }, { "from": "f", "to": "b" }, { "from": "f", "to": "c", "kind": "async" },
        { "from": "a", "to": "j" }, { "from": "b", "to": "j" }, { "from": "c", "to": "j" },
        { "from": "j", "to": "d" },
        { "from": "d", "to": "ok", "label": "yes" },
        { "from": "d", "to": "err", "label": "no", "kind": "error" }
      ]
    },
    {
      "title": "State machine",
      "summary": "Invented states, here only so the state kind, a self-edge and a reverse pair render once.",
      "nodes": [
        { "id": "s", "label": "Created", "kind": "start" },
        { "id": "idle", "label": "Idle", "kind": "state" },
        { "id": "run", "label": "Running", "kind": "state", "note": "holds the lock" },
        { "id": "stop", "label": "Stopped", "kind": "end" }
      ],
      "edges": [
        { "from": "s", "to": "idle" },
        { "from": "idle", "to": "run", "label": "start" },
        { "from": "run", "to": "idle", "label": "pause" },
        { "from": "run", "to": "run", "label": "tick", "kind": "retry" },
        { "from": "run", "to": "stop", "label": "halt" }
      ]
    },
    {
      "title": "Multiple entries",
      "summary": "Two alternative entries meet at shared work, which can reach either terminal outcome.",
      "nodes": [
        { "id": "hook", "label": "Webhook received", "kind": "start" },
        { "id": "timer", "label": "Schedule fired", "kind": "start" },
        { "id": "load", "label": "Load request", "kind": "step" },
        { "id": "valid", "label": "Request valid?", "kind": "decision" },
        { "id": "accepted", "label": "Accepted", "kind": "success" },
        { "id": "rejected", "label": "Rejected", "kind": "end" }
      ],
      "edges": [
        { "from": "hook", "to": "load" },
        { "from": "timer", "to": "load" },
        { "from": "load", "to": "valid" },
        { "from": "valid", "to": "accepted", "label": "yes" },
        { "from": "valid", "to": "rejected", "label": "no", "kind": "error" }
      ]
    },
    {
      "title": "Reconvergence and retry",
      "summary": "Only one route runs. Both meet at Continue, then the check either finishes or loops back. Cancel exits separately.",
      "nodes": [
        { "id": "s", "label": "Start", "kind": "start" },
        { "id": "choice", "label": "Choose route", "kind": "decision" },
        { "id": "quick", "label": "Quick route", "kind": "step" },
        { "id": "careful", "label": "Careful route", "kind": "step" },
        { "id": "merge", "label": "Continue", "kind": "step" },
        { "id": "check", "label": "Check passed?", "kind": "decision" },
        { "id": "done", "label": "Done", "kind": "success" },
        { "id": "revise", "label": "Revise input", "kind": "step" },
        { "id": "cancelled", "label": "Cancelled", "kind": "end" }
      ],
      "edges": [
        { "from": "s", "to": "choice" },
        { "from": "choice", "to": "quick", "label": "quick" },
        { "from": "choice", "to": "careful", "label": "careful" },
        { "from": "choice", "to": "cancelled", "label": "cancel" },
        { "from": "quick", "to": "merge" },
        { "from": "careful", "to": "merge" },
        { "from": "merge", "to": "check" },
        { "from": "check", "to": "done", "label": "yes" },
        { "from": "check", "to": "revise", "label": "no" },
        { "from": "revise", "to": "choice", "label": "try again", "kind": "retry" }
      ]
    }
  ]
}
